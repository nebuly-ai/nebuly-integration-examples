# Required
NEBULY_API_KEY=
COMPLIANCE_API_KEY=
# Workspace UUID (not org-*): used in /v1/compliance/workspaces/{id}/logs
COMPLIANCE_WORKSPACE_ID=
COMPLIANCE_BASE_URL=https://api.chatgpt.com/v1/compliance

# Optional
NEBULY_ENDPOINT=https://backend.nebuly.com/event-ingestion/api/v3/events/trace_interaction
# OpenAI: 100 req/min per workspace, per HTTP method + route (listing vs download)
COMPLIANCE_MAX_REQUESTS_PER_MINUTE=100
ANONYMIZE=false
INTERACTION_IDLE_MINUTES=30
# Wait for CODEX_TURN before emitting Codex with cost (2–3h typical lag). 0 = skip turn listing.
CODEX_COST_WAIT_HOURS=4
# Optional directory join (pick one, not both):
# ENTRA_FETCH=false
# Live Graph fetch at sync startup (requires: poetry install --with entra)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_LOGIN_BASE_URL=https://login.microsoftonline.com
# GRAPH_BASE_URL=https://graph.microsoft.com
# Or use a file from ../microsoft_entra (`poetry run python -m entra_export`):
# ENTRA_EXTRACT_PATH=../microsoft_entra/entra.json
