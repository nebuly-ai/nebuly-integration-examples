# Required
NEBULY_API_KEY=
BEDROCK_S3_BUCKET=
BEDROCK_ACCOUNT_ID=
BEDROCK_REGION=

# Optional: key prefix set in the Bedrock "Model invocation logging" settings
BEDROCK_S3_PREFIX=

# Optional: standard boto3 credential resolution (AWS_PROFILE, env keys, SSO...)
# is used when AWS_ROLE_ARN is unset
AWS_PROFILE=
AWS_REGION=

# Optional: assume a read-only role in the customer account
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=

# Optional
NEBULY_ENDPOINT=https://backend.nebuly.com/event-ingestion/api/v3/events/trace_interaction
BEDROCK_SETTLE_LAG_SECONDS=300
# Days a conversation without a session id can still be continued
CONVERSATION_CHAIN_TTL_DAYS=30
ANONYMIZE=false
USER_HASH_SECRET=
SEND_PLAIN_END_USER=false
