# Settings read from the environment (or this .env file) by both connectors:
#   python -m bedrock_sync.runtime    Bedrock model invocation logs on S3
#   python -m bedrock_sync.agentcore  AgentCore observability on CloudWatch
# How a run behaves (dates, state file, retention...) is set with flags: --help.

# Required by both
NEBULY_API_KEY=
BEDROCK_ACCOUNT_ID=
BEDROCK_REGION=
# Key for the HMAC pseudonym of each end user (keep it stable and secret)
USER_HASH_SECRET=

# Required by the runtime connector: where model invocation logging writes
BEDROCK_S3_BUCKET=
# Optional: the key prefix set in the model invocation logging settings
BEDROCK_S3_PREFIX=

# AWS credentials: the standard boto3 chain (AWS_PROFILE, environment keys,
# SSO, instance role) is used unless AWS_ROLE_ARN is set
AWS_PROFILE=
# Optional: assume a read-only role in the account that holds the logs
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=

# Optional
NEBULY_ENDPOINT=https://backend.nebuly.com/event-ingestion/api/v3/events/trace_interaction
# true: send end user ids as they are instead of their pseudonym
SEND_PLAIN_END_USER=false
# true: ask Nebuly to anonymize personal data in the content
ANONYMIZE=false
