# Required
GITHUB_TOKEN=
GITHUB_ENTERPRISE=

# Nebuly (not required when CSV_EXPORT=true)
NEBULY_API_KEY=

# Optional
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
NEBULY_ENDPOINT=https://backend.nebuly.com/event-ingestion/api/v3/events/trace_interaction
# Sources are the --sources flag (default rest). Add s3 and/or azure_blob only
# after the S3 or Azure Blob settings below are set, e.g. --sources rest,s3.
REST_OVERLAP_SECONDS=60
PAIR_WAIT_MINUTES=15
CONVERSATION_GAP_HOURS=8
INTERACTION_IDLE_MINUTES=30
RESOLVE_USERS=true
ANONYMIZE=false
CSV_EXPORT=false
CSV_EXPORT_PATH=./interactions.csv

# S3 streaming (sources includes s3)
S3_BUCKET=
S3_PREFIX=
# Objects are read by write time. Re-read objects written within this many seconds
# before the newest one already ingested, to catch late uploads (S3 and Azure Blob).
# OBJECT_LAG_SECONDS=3600
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Azure Blob streaming (sources includes azure_blob)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_BLOB_ACCOUNT_URL=
# AZURE_BLOB_CONTAINER=
# AZURE_BLOB_PREFIX=
# AZURE_BLOB_SAS_TOKEN=

# Optional directory join (pick one, not both):
# ENTRA_FETCH=false
# ENTRA_EXTRACT_PATH=../microsoft_entra/entra.json