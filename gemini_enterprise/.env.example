# Required
NEBULY_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=
GCP_COLLECTION=default_collection
GCP_ENGINE_ID=

# Optional
GOOGLE_APPLICATION_CREDENTIALS=
NEBULY_ENDPOINT=https://backend.nebuly.com/event-ingestion/api/v3/events/trace_interaction
GCP_SETTLE_LAG_SECONDS=60
GCP_LOG_BATCH_SIZE=500
GCP_LOG_PAGE_SIZE=1000
GCP_TRACE_CONCURRENCY=32
ANONYMIZE=false
USER_HASH_SECRET=
SEND_PLAIN_END_USER=false

# Log source (default: logging). Set GCP_LOG_SOURCE=bigquery to read from a
# Cloud Logging sink export; GCP_BIGQUERY_TABLE and GCP_BIGQUERY_LOCATION are
# only required when using the bigquery source.
GCP_LOG_SOURCE=logging
GCP_BIGQUERY_TABLE=
GCP_BIGQUERY_LOCATION=
